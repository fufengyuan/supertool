{
    "extends": ["modern"],
    "rules": {
        "no-debugger": "error",
        "no-unused-vars": ["error", { "caughtErrors": "none", "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
        "eqeqeq": ["error", "always", { "null": "ignore" }],
        "semi": ["error", "always"],
        "quotes": ["error", "double"],
        "curly": ["error", "all"],
        "prefer-const": "error",
        "no-var": "error"
    },
    "ignorePatterns": ["dist/", "node_modules/", "public/", "tauri/target/"]
}
