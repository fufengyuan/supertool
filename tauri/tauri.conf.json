{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperTool",
  "version": "4.64.0",
  "identifier": "com.fufengyuan.supertool.tauri",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vue-tsc --noEmit && vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SuperTool",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "deb", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": [
      "../resources/openvpn/linux-x64/openvpn",
      "../resources/openvpn/macos-arm64",
      "../resources/openvpn/macos-x64",
      "../target/release/stool",
      "../skills/**/*",
      "../.hermes/profiles/**/*"
    ]
  }
}
