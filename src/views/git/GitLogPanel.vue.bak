  border-bottom: 1px solid color-mix(in oklab, var(--color-base-content) 10%, transparent);
}

.detail-title {
  font-weight: 600;
  font-size: 12px;
}

.detail-body {
  padding: 8px 10px;
}

.detail-row {
  display: flex;
