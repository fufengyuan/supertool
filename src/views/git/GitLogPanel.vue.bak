  border: 1px solid color-mix(in oklab, var(--color-base-content) 20%, transparent);
}

.view-toggle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 24px;
  padding: 0;
  border: none;
  background: transparent;
  color: color-mix(in oklab, var(--color-base-content) 60%, transparent);
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.15s;
}

.view-toggle-btn:hover {
  color: var(--color-base-content);
  background: var(--hover-bg);
}

.view-toggle-btn.active {
  color: var(--color-primary);
  background: color-mix(in oklab, var(--color-primary) 10%, transparent);
}

/* ===================== Git Graph ===================== */
.git-graph-wrap {
  position: relative;
  flex: 1;
  overflow: hidden;
  background: #1a1a2e;
  border-radius: 4px;
}

.git-graph-canvas {
  display: block;
  width: 100%;
  height: 100%;
  cursor: pointer;
}

.graph-loading,
.graph-empty {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  color: color-mix(in oklab, var(--color-base-content) 60%, transparent);
}

.graph-loading svg {
  animation: spin 1s linear infinite;
}

/* ===================== Git Console ===================== */
.git-console-wrap {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
  background: #0d1117;
  border-radius: 4px;
  font-family: 'JetBrains Mono', 'Consolas', monospace;
}

.git-console-output {
  flex: 1;
  overflow-y: auto;
  padding: 8px 12px;
  font-size: 12px;
  line-height: 1.5;
}

.console-entry {
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.console-cmd {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #58a6ff;
  font-weight: 500;
}

.console-prompt {
  color: #3fb950;
  font-weight: bold;
}

.console-cmd-text {
  color: #e6edf3;
}

.console-output-text {
  margin: 4px 0 0 18px;
  padding: 8px;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 4px;
  white-space: pre-wrap;
  word-break: break-all;
  color: #c9d1d9;
  font-size: 11px;
  max-height: 300px;
  overflow-y: auto;
}

.console-entry.error .console-cmd-text {
  color: #f85149;
}

.console-entry.error .console-output-text {
  color: #f85149;
  background: rgba(248, 81, 73, 0.05);
}

.console-welcome {
  padding: 20px;
  text-align: center;
  color: #8b949e;
}

.console-welcome p {
  margin: 4px 0;
}

.console-hint {
  font-size: 11px;
}

.console-hint code {
  background: rgba(255, 255, 255, 0.08);
  padding: 2px 6px;
  border-radius: 3px;
  color: #58a6ff;
}

.git-console-input-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: rgba(255, 255, 255, 0.03);
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.console-input-prompt {
  color: #3fb950;
  font-weight: bold;
  font-size: 13px;
  flex-shrink: 0;
}

.git-console-input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: #e6edf3;
  font-family: 'JetBrains Mono', 'Consolas', monospace;
  font-size: 12px;
}

.git-console-input::placeholder {
  color: #484f58;
}

/* ===================== 动画 ===================== */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.spin {
  animation: spin 1s linear infinite;
}

/* ===================== 滚动条 ===================== */
.log-table-wrap::-webkit-scrollbar,
.diff-content::-webkit-scrollbar {
  width: 6px;
}

.log-table-wrap::-webkit-scrollbar-track,
.diff-content::-webkit-scrollbar-track {
  background: transparent;
}

.log-table-wrap::-webkit-scrollbar-thumb,
.diff-content::-webkit-scrollbar-thumb {
