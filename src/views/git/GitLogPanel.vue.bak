  flex-wrap: wrap;
}

.ref-tag {
  font-size: 10px;
  padding: 1px 5px;
  border-radius: 3px;
  white-space: nowrap;
}

.ref-head {
  background: rgba(34, 197, 94, 0.2);
  color: #22c55e;
}

.ref-local {
  background: rgba(59, 130, 246, 0.2);
  color: #3b82f6;
}

.ref-remote {
  background: rgba(168, 85, 247, 0.2);
  color: #a855f7;
}

.empty-log {
  display: flex;
  align-items: center;
  justify-content: center;
